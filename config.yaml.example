# Example YAML configuration file for MikroTik Mass Updater.
# All keys are optional. CLI arguments override these values.
# Place sensitive values (password, cloud_password) only if you are
# comfortable keeping them on disk in plain text.

# username: admin
# password: my_secret_password
# threads: 10
# timeout: 30
# port: 8728
# ssl_port: 8729
# ssl: false
# API-SSL certificate verification is enabled by default. Set false only when
# a router's certificate cannot be trusted or matched to its host name.
# ssl_verify: true
# Optional CA bundle; when provided, it replaces system CA roots.
# ssl_ca_file: routers-ca.pem
# Enable only if an older router cannot negotiate the default cipher set.
# ssl_legacy_ciphers: false
# ip_list: list.txt
# start_line: 1
# update_check_attempts: 15
# update_check_delay: 2.0
# dry_run: false
# no_colors: false
# debug: false
# cloud_password: my_cloud_password
# upgrade_firmware: false
# custom_commands: commands.yaml

# Read-only inventory: no backup, no updates, no firmware upgrade, no reboot.
# inventory: false

# Reports (HTML/CSV/state) are written for every run; disable with:
# report: false

# Process only these hosts (comma-separated). Matched against the host part
# of each IP list entry, never against credentials.
# only: "192.168.1.5,192.168.1.7"

# Re-run only hosts that failed in a previous run. Use "latest" for the newest
# state file under log/, or a path to a run directory or state.json file.
# retry_failed: latest
